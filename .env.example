# JanSetu Frontend Configuration
# Copy this file to .env.local or .env for local development

# Backend API Base URL (Kenneth's FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# API Mode: Set to false to connect to real backend APIs, or true to use mock storage
VITE_USE_MOCK_API=false

# Application Display Settings
VITE_APP_NAME="JanSetu"
VITE_DEFAULT_LANGUAGE="en"
